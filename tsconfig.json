{
  "compilerOptions": {
    "target": "ES2025",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2025"],
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "#platform": ["./app/platform/browser.ts"]
    },
    "types": ["chrome", "dom-chromium-ai"]
  },
  "include": ["app"]
}
