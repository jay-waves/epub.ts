{
	"name": "epub.ts",
	"license": "MIT",
	"private": true,
	"version": "0.5.4",
	"type": "module",
	"browserslist": {
		"production": [
			"Chrome >= 120",
			"Edge >= 120",
			"Firefox >= 121",
			"Safari >= 17.2",
			"iOS >= 17.2"
		]
	},
	"scripts": {
		"build:chrome": "pnpm typecheck && node scripts/build-chrome.mjs",
		"build:linux": "pnpm build:web && node scripts/build-launcher.mjs linux-amd64",
		"build:windows": "pnpm build:web && node scripts/build-launcher.mjs windows-amd64",
		"build:web": "pnpm typecheck && VIEWER_PLATFORM=web vite build",
		"deploy:web": "bash scripts/deploy-web.sh",
		"typecheck": "tsgo --noEmit"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.2.4",
		"@types/chrome": "^0.1.40",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vitejs/plugin-react": "^6.0.2",
		"tailwindcss": "^4.2.4",
		"vite": "^8.0.10",
		"yazl": "2.5.1"
	},
	"dependencies": {
		"@floating-ui/react": "^0.27.20",
		"@mathjax/mathjax-newcm-font": "^4.1.3",
		"@mathjax/src": "^4.1.3",
		"@radix-ui/react-slider": "^1.3.6",
		"@use-gesture/vanilla": "^10.3.1",
		"@zip.js/zip.js": "^2.8.26",
		"highlight.js": "^11.11.1",
		"idb-keyval": "^6.2.5",
		"lucide-react": "^1.16.0",
		"medium-zoom": "^1.1.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"wheel-gestures": "^2.2.48",
		"zustand": "^5.0.14"
	}
}
