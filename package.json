{
	"name": "epub.ts",
	"license": "MIT",
	"private": true,
	"version": "0.7.4",
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=24"
	},
	"browserslist": {
		"production": [
			"Chrome >= 152",
			"Edge >= 152",
			"Firefox >= 154",
			"Safari >= 26",
			"iOS >= 26"
		]
	},
	"scripts": {
		"dev": "vite",
		"compile": "pnpm typecheck && vite build",
		"test": "node --test tests/*.test.ts",
		"package:chrome": "node scripts/package-chrome.mjs",
		"package:linux:binary": "node scripts/package-launcher.mjs linux-amd64",
		"package:windows:binary": "node scripts/package-launcher.mjs windows-amd64",
		"package:macos:binary": "node scripts/package-launcher.mjs darwin-arm64",
		"package:deb": "pnpm package:linux:binary && sh scripts/package-linux.sh deb",
		"package:rpm": "pnpm package:linux:binary && sh scripts/package-linux.sh rpm",
		"package:linux": "pnpm package:linux:binary && sh scripts/package-linux.sh deb && sh scripts/package-linux.sh rpm",
		"package:windows": "pnpm package:windows:binary && sh scripts/package-windows.sh",
		"package:macos": "pnpm package:macos:binary && sh scripts/package-macos.sh",
		"package:all": "pnpm package:chrome && pnpm package:linux && pnpm package:windows",
		"build:all": "pnpm compile && pnpm package:all",
		"deploy:web": "bash scripts/deploy-web.sh",
		"typecheck": "tsc --noEmit",
		"check": "pnpm typecheck && pnpm test"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/chrome": "^0.2.7",
		"@types/dom-chromium-ai": "^0.0.17",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"yazl": "^3.3.1"
	},
	"dependencies": {
		"@mathjax/mathjax-newcm-font": "^4.1.3",
		"@mathjax/src": "^4.1.3",
		"@radix-ui/react-slider": "^1.4.7",
		"@zip.js/zip.js": "^2.8.61",
		"highlight.js": "^11.12.0",
		"idb-keyval": "^6.3.0",
		"lucide-react": "^1.37.0",
		"medium-zoom": "^1.1.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"wheel-gestures": "^2.2.48"
	}
}
